# 채팅 MCP 서버 — 예시. **실값을 커밋하지 않는다.**
#
# compose 가 environment 로 덮으므로 컨테이너 운영에는 이 파일이 필요 없다.
# 호스트에서 단독으로 띄워 볼 때만 쓴다.

# back 주소 — 컨테이너 안에서는 서비스 이름, 호스트에서는 localhost:48000
CHAT_BACK_URL=http://back:8000
CHAT_BACK_TIMEOUT_SEC=10

# Streamable HTTP transport 의 DNS rebinding 보호에 통과시킬 Host 헤더(콤마 구분).
# 워커가 `http://mcp:28081/mcp` 로 붙으므로 그 Host 가 들어 있어야 한다.
MCP_ALLOWED_HOSTS=mcp,mcp:28081,localhost,localhost:28081,127.0.0.1:28081
MCP_ALLOWED_ORIGINS=

LOG_LEVEL=INFO
