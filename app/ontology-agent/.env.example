# 온톨로지 데모 env — **키 목록이다. 값은 여기 적지 않는다.**
#
#   cp .env.example .env   후에 값을 채운다. `.env` 는 gitignore 다.
#
# 전 키가 `config.py` 의 `Settings`(prefix `ONTOLOGY_`)와 1:1 이다. 유일한 예외는
# 맨 아래 `ONTOLOGY_LIVE_REGRESSION` 으로, 설정이 아니라 **테스트 스위치**다.
# 값을 코드에 하드코딩하지 않는다 — 전부 이 파일을 지난다(config.py 머리 주석).
#
# 필수는 두 개뿐이다: `ONTOLOGY_DEMO_PASSWORD` 와 `ONTOLOGY_DB_PATH`(또는
# `ONTOLOGY_DATA_DIR`). 나머지는 기본값이 배포에서 그대로 맞는다.

# ── 접속 게이트 (필수) ──────────────────────────────────────────────────
# 내부 공유용 비밀번호 하나(DEC-005 D2 · SPEC-003 §4). rate limit·계정 체계는 없다.
# **미주입이면 발급·검증이 양쪽 다 닫혀 전 API 가 401 이다** — 빈 값으로 열리지 않는다.
# 값은 레포·문서·응답·로그 어디에도 적지 않는다. 생성:  openssl rand -base64 18
ONTOLOGY_DEMO_PASSWORD=
# 세션 쿠키 이름·만료(기본 ontology_demo_sid · 30일). 보통 건드릴 일이 없다.
# ONTOLOGY_SESSION_COOKIE_NAME=
# ONTOLOGY_SESSION_MAX_AGE_SEC=
# https 가 아닌 곳(로컬 http)에서만 0 으로 내린다. 배포에서는 1 이다.
# 쿠키 SameSite 는 이 값에서 **파생**한다 — 1이면 None(교차 사이트), 0이면 Lax.
# ONTOLOGY_SESSION_COOKIE_SECURE=

# ── CORS (배포에서 필수) ───────────────────────────────────────────────
# 브라우저가 API 를 부를 수 있는 오리진 목록(JSON 배열). **프론트는 Vercel, API 는
# 홈서버라 배포에서 둘은 항상 다른 오리진이다** — 비면 화면이 API 에 한 번도 못 닿는다.
# `credentials: include` 를 쓰므로 `*` 는 브라우저 규칙상 쓸 수 없다.
# 기본값은 로컬 next dev 두 주소다. 배포:  ["https://profile.kknaks.cloud"]
ONTOLOGY_ALLOWED_ORIGINS=

# ── 데이터 경로 ────────────────────────────────────────────────────────
# 원천 배치 디렉토리(bronze/·silver/_scoring/·ontology/ 가 있는 곳). **PII 라 레포 밖.**
# 서빙 컨테이너는 필요 없다 — 빌드·게이트 1 을 돌릴 때만 쓴다.
# ONTOLOGY_DATA_DIR=
# 산출 DB 경로. 미지정이면 $ONTOLOGY_DATA_DIR/db/ontology_demo.db 다.
# 배포 컨테이너는 볼륨 경로(/data/db/ontology_demo.db)를 받는다.
ONTOLOGY_DB_PATH=
# 채팅 저장소. **온톨로지 DB 와 다른 파일이어야 한다** — 같은 파일에 두면 재빌드가
# 대화 기록을 함께 날린다. 미지정이면 DB 옆 ontology_chat.db 다.
# ONTOLOGY_CHAT_DB_PATH=

# ── LLM 경로 (open-kknaks — ADR-04) ────────────────────────────────────
# 배포 컨테이너는 redis://redis:6379/0. 로컬은 호스트 포트(기본 46379).
# ONTOLOGY_REDIS_URL=
# ⚠ AI_NAMESPACE·AI_QUEUE 는 compose 의 `ontology-worker` 와 **반드시 같은 값**이다.
#   어긋나면 제출한 태스크를 아무도 집어 가지 않아 답변이 영원히 pending 이다.
# ONTOLOGY_AI_NAMESPACE=
# ONTOLOGY_AI_QUEUE=
# ONTOLOGY_AI_PROVIDER=
# 모델과 reasoning effort 는 **짝**이다 — 허용 effort 가 모델별로 갈린다.
# 레퍼런스 통과 조합은 gpt-5.6-terra + low 다. `none` 은 금지(툴 연결 판단이 죽는다).
# ONTOLOGY_AI_MODEL=
# ONTOLOGY_AI_REASONING_EFFORT=
# 첫 응답 상한(초). 초과하면 답변이 failed + AI_TIMEOUT 이다.
# ONTOLOGY_AI_TIMEOUT_SEC=
# 구조화 답변 스키마 위반 시 재시도 횟수(SPEC-005 OQ-5 — 1회).
# ONTOLOGY_AI_SCHEMA_RETRY=

# ── MCP 도구 서버 ──────────────────────────────────────────────────────
# 워커 컨테이너에서 본 도구 서버 주소. codex 의 mcp_servers.<key>.url 에 그대로 박힌다.
# ONTOLOGY_MCP_URL=
# ONTOLOGY_MCP_HOST=
# ONTOLOGY_MCP_PORT=
# ONTOLOGY_MCP_SERVER_KEY=
# ⚠ **명시 주입이 필요하다.** 기본값 ["*"] 는 SDK 의 DNS rebinding 보호를 무력화하는
#   값이면서 실제로는 Invalid Host header 로 동작하지도 않는다. 붙는 Host 를 그대로 적는다.
#   compose 가 ontology-mcp 서비스에 주입하므로 배포에서는 여기 비워도 된다.
#   로컬에서 MCP 를 직접 띄울 때는 필요하다:  ["localhost:28081","127.0.0.1:28081"]
ONTOLOGY_MCP_ALLOWED_HOSTS=
# ONTOLOGY_MCP_ALLOWED_ORIGINS=

# ── 테스트 스위치(설정 아님) ────────────────────────────────────────────
# 1 이면 라이브 회귀(게이트 4·5)가 돈다 — redis + ontology-worker + codex 인증이
# 서 있어야 한다. 미설정이면 라이브 5본이 skip 되고 기준값 계층만 돈다.
# ONTOLOGY_LIVE_REGRESSION=
