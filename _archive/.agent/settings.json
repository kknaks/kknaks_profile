{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .agent/scripts/session_git_pull.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agent/scripts/product_doc_pipeline.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
