# 공공데이터포털(data.go.kr) 일반 인증키 — 「Decoding」 키를 넣는다. 이 파일을 .env 로 복사해서 채운다.
# .env 는 git 에 올리지 않는다(.gitignore).
MFDS_API_KEY=

# 아래는 선택. 비워 두면 괄호 안 기본값.
# 캐시 유효 기간(일, 7)
MFDS_CACHE_TTL_DAYS=
# 하루 실제 HTTP 호출 상한(1000) — 캐시 적중은 세지 않는다. 날짜는 한국 시간 기준
MFDS_DAILY_LIMIT=
# all_pages=true 일 때 최대 페이지 수(10)
MFDS_MAX_PAGES=
# 요청 시간 초과(초, 30)
MFDS_TIMEOUT_SECONDS=
# 캐시 폴더(이 폴더의 cache/)
MFDS_CACHE_DIR=
