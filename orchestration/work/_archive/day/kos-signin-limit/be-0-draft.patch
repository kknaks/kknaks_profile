+async def _post_json(
+    http: httpx.AsyncClient, url: str, body: dict[str, Any], headers: dict[str, str]
+) -> dict[str, Any]:
+    try:
+        resp = await http.post(url, json=body, headers=headers)
+    except httpx.HTTPError as exc:
+        raise KosError(f"network {type(exc).__name__}") from None
+    if resp.status_code // 100 != 2:
+        raise _error_of(resp)
+    if not resp.content:
+        return {}
+    try:
+        out = resp.json()
+    except ValueError:
+        raise KosError("response is not JSON", resp.status_code) from None
+    return out if isinstance(out, dict) else {}
+
+
+async def list_active_sign_ins(
+    http: httpx.AsyncClient,
+    internal_base: str,
+    email: str,
+    password: str,
+    headers: dict[str, str],
+) -> list[ActiveSignIn]:
+    """`get-active-sign-ins {email, password}` → `data[{id, userAgent, …}]` (시스템 · 직원 공용)."""
+    body = await _post_json(
+        http,
+        f"{internal_base.rstrip('/')}/{ACTIVE_SIGN_INS_PATH}",
+        {"email": email, "password": password},
+        headers,
+    )
+    rows = body.get("data")
+    if not isinstance(rows, list):
+        raise KosError("get-active-sign-ins: unexpected response shape")
+    out: list[ActiveSignIn] = []
+    for row in rows:
+        if not isinstance(row, dict) or not row.get("id"):
+            continue
+        agent = row.get("userAgent")
+        out.append(ActiveSignIn(id=str(row["id"]), user_agent=agent if isinstance(agent, str) else ""))
+    return out
+
+
