+def is_sign_in_limit(resp: httpx.Response) -> bool:
+    """sign-in 401 이 기기 수 제한(`message: SignInLimitExceeded`)인지 — 틀린 비밀번호와 가른다."""
+    if resp.status_code != 401:
+        return False
+    try:
+        body = resp.json()
+    except ValueError:
+        return False
+    return isinstance(body, dict) and body.get("message") == SIGN_IN_LIMIT
+
+
+def sign_in_limit_error() -> KosError:
+    return KosError(f"HTTP 401 {SIGN_IN_LIMIT}", 401, SIGN_IN_LIMIT)
+
