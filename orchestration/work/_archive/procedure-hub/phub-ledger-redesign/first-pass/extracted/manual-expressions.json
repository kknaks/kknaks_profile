  {"id": "MX101", "pointer": "/M1/aftercare/0", "text": "주사 직후 시술 부위를 강하게 누르거나 문지르지 않기", "category": "time_degree_negated_instruction"},
  {"id": "MX102", "pointer": "/M1/aftercare/0", "text": "자세 제한의 독립 효과는 RCT에서 확인되지 않음", "category": "negated_evidence_statement"},
  {"id": "MX103", "pointer": "/M1/mechanism", "text": "뇌나 척수 같은 중추신경에는 영향을 주지 않고", "category": "negated_statement"},
  {"id": "MX104", "pointer": "/M1/mechanism", "text": "주사 맞은 부위의 근육과 땀샘에만 작용한다", "category": "site_restriction"},
  {"id": "MX105", "pointer": "/M1/overview", "text": "2002년 미국 FDA, 2008년 한국 식약처에서 미간주름 치료용으로 정식 승인받았다", "category": "regulatory_claim_scoped"},
  {"id": "MX106", "pointer": "/M1/onset_duration/onset", "text": "시술 후 12시간~4일 사이에", "category": "time_window_with_anchor"},
  {"id": "MX107", "pointer": "/M1/onset_duration/duration", "text": "3~6개월 유지 (사람마다 다름)", "category": "time_with_variability"},
  {"id": "MX108", "pointer": "/M1/contraindications/relative/0", "text": "임신 중이거나 수유 중일 때는 미루는 게 좋음", "category": "population_recommendation"},
  {"id": "MX109", "pointer": "/M1/contraindications/relative/1", "text": "복용 중이면 효과가 과하게 나타날 수 있으니 의사에게 알릴 것", "category": "medication_possibility_obligation"},
  {"id": "MX110", "pointer": "/M2/safety/serious/0", "text": "드물지만 위험", "category": "frequency_severity_contrast"},
  {"id": "MX111", "pointer": "/M2/safety/serious/3", "text": "코, 이마 등 혈관이 눈동맥과 연결된 부위 시술 시 극히 드물게 발생", "category": "site_condition_frequency"},
  {"id": "MX112", "pointer": "/M2/safety/emergency/0", "text": "주사 직후 피부가 하얗게 변하면 혈관이 막혔을 가능성", "category": "sign_condition_possibility"},
  {"id": "MX113", "pointer": "/M2/safety/emergency/0", "text": "즉시 히알루로니다아제(분해효소) 투여 필요", "category": "urgent_action"},
  {"id": "MX114", "pointer": "/M2/aftercare/2", "text": "시술 후 화장은 완전히 지우고 무균 상태에서 시술해야 하며", "category": "time_order_mismatch", "note": "「시술 후」 아래 시술 전 행위(I4)"},
  {"id": "MX115", "pointer": "/M2/mechanism", "text": "자가지방이식은 본인의 지방세포를 옮기는 방식이라 거부반응 없이", "category": "negated_causal"},
  {"id": "MX116", "pointer": "/M2/onset_duration/peak", "text": "붓기가 빠진 후 1~2주 뒤", "category": "time_window_with_anchor"},
  {"id": "MX117", "pointer": "/M2/onset_duration/duration", "text": "히알루론산 필러 6~18개월, 칼슘 필러 12~24개월, 자가지방이식 6~12개월 (생착률에 따라 다름)", "category": "subtype_time"},
  {"id": "MX118", "pointer": "/M2/contraindications/absolute/2", "text": "소 콜라겐 필러 사용 시 피부반응검사에서 양성 반응이 나온 경우", "category": "subtype_test_condition"},
  {"id": "MX119", "pointer": "/M2/contraindications/relative/1", "text": "복용 중이면 멍이 잘 들 수 있으니 의사에게 알릴 것", "category": "medication_possibility_obligation"},
  {"id": "MX120", "pointer": "/M3/safety/serious/1", "text": "극히 드물지만 필러가 혈관에 들어갈 위험", "category": "frequency_degree_scoped"},
  {"id": "MX121", "pointer": "/M3/aftercare/0", "text": "부드러운 마사지는 선택", "category": "optional_instruction"},
  {"id": "MX122", "pointer": "/M3/aftercare/0", "text": "5-5-5 규칙의 결절 예방효과는 RCT 미입증; 핵심은 희석·주입", "category": "negated_evidence_statement"},
  {"id": "MX123", "pointer": "/M3/mechanism", "text": "효과 지속기간이 평균 18~24개월로 기존 필러보다 길다", "category": "quantity_comparison"},
  {"id": "MX124", "pointer": "/M3/onset_duration/onset", "text": "즉각적 볼륨 효과 + 콜라겐 재생은 4~6주 후부터 시작", "category": "symbol_conjunction_time", "note": "「+」가 효과 두 가지의 병렬"},
  {"id": "MX125", "pointer": "/M3/onset_duration/duration", "text": "PCL(엘란쎄) 12~48개월 (제품에 따라 다름)", "category": "subtype_time"},
  {"id": "MX126", "pointer": "/M3/related_techniques/0", "text": "즉각적 볼륨 효과가 필요할 때 병합", "category": "condition_combination"},
  {"id": "MX127", "pointer": "/M4/safety/serious/1", "text": "드물게 심한 알레르기 반응", "category": "frequency_severity_scoped", "note": "uncommon/0 「알레르기 반응」과 수식어로 구분"},
  {"id": "MX128", "pointer": "/M4/overview", "text": "소량씩 여러 포인트에 주입", "category": "quantity_word_scoped"},
  {"id": "MX129", "pointer": "/M4/mechanism", "text": "기존 필러와 같은 연조직 확대 기능보다는", "category": "comparison_contrast"},
  {"id": "MX130", "pointer": "/M4/onset_duration/onset", "text": "시술 직후~2일 이내", "category": "time_range"},
  {"id": "MX131", "pointer": "/M4/contraindications/relative/0", "text": "항응고제 복용 중인 경우 (멍이 잘 들 수 있음)", "category": "medication_possibility"},
  {"id": "MX132", "pointer": "/M4/contraindications/relative/1", "text": "임산부, 생리 중인 경우 주의 필요", "category": "population_recommendation"},
  {"id": "MX133", "pointer": "/M5/safety/common/2", "text": "3~7일 정도 멍이 들 수 있음", "category": "possibility_with_time"},
  {"id": "MX134", "pointer": "/M5/safety/serious/0", "text": "알레르기·거부반응이 거의 없음 (매우 안전한 시술)", "category": "negated_safety_claim", "note": "serious 칸이 사건 부재 진술(I6)"},
  {"id": "MX135", "pointer": "/M5/safety/uncommon/0", "text": "시술 결과에 차이가 있을 수 있음", "category": "possibility_variability"},
  {"id": "MX136", "pointer": "/M5/aftercare/2", "text": "깊은 주름이나 심한 노화에는 PRP 단독보다 고주파, IPL, 필러, 보톡스, 지방이식 등과 병행하는 것이 좋음", "category": "condition_combination_recommendation", "note": "aftercare 칸이 병합 권고(I13)"},
  {"id": "MX137", "pointer": "/M5/onset_duration/duration", "text": "(반복시술은 4~6주 간격 가능)", "category": "interval"},
  {"id": "MX138", "pointer": "/M5/onset_duration/onset", "text": "시술 후 3~6주경부터", "category": "time_window_with_anchor"},
  {"id": "MX139", "pointer": "/M5/contraindications/relative/2", "text": "색소성 질환에 대한 치료 효과는 적은 편", "category": "efficacy_in_contraindication", "note": "금기 칸이 효과 진술(I8)"},
  {"id": "MX140", "pointer": "/M5/related_techniques/0", "text": "MTS로 미세 구멍을 낸 후 PRP를 도포해", "category": "sequence_after"},
  {"id": "MX141", "pointer": "/M5/related_techniques/2", "text": "여드름흉터에 서브시전 후 PRP 주입", "category": "sequence_after"},
  {"id": "MX142", "pointer": "/M6/safety/common/0", "text": "채취 부위 및 주입 부위의 멍과 붓기", "category": "site_role"},
  {"id": "MX143", "pointer": "/M6/safety/serious/1", "text": "지방이 혈관에 들어가는 것 -- 극히 드묾", "category": "frequency_degree_scoped"},
  {"id": "MX144", "pointer": "/M6/overview", "text": "한 번 생착(살아붙으면)되면 반영구적으로 유지된다", "category": "condition_duration"},
  {"id": "MX145", "pointer": "/M6/aftercare/2", "text": "시술 후 1~2주간 격렬한 운동 피하기", "category": "time_window_avoidance"},
  {"id": "MX146", "pointer": "/M6/onset_duration/peak", "text": "붓기가 빠진 후 3~6개월 뒤 최종 생착량 확인", "category": "time_window_with_anchor"},
  {"id": "MX147", "pointer": "/M6/onset_duration/duration", "text": "(생착률 30~70%, 개인차 큼)", "category": "quantity_with_target"},
  {"id": "MX148", "pointer": "/M6/contraindications/absolute/0", "text": "채취할 지방이 충분하지 않은 경우 (극심한 저체중)", "category": "negated_threshold_condition"},
  {"id": "MX149", "pointer": "/M6/related_techniques/0", "text": "소량 볼륨 보정에 간편한 대안", "category": "alternative"},
  {"id": "MX150", "pointer": "/M7/safety/serious/0", "text": "안면신경 일시적 마비 (드물게 발생, 대부분 회복됨)", "category": "frequency_course_scoped"},
  {"id": "MX151", "pointer": "/M7/safety/serious/1", "text": "안면신경 영구 손상 (극히 드묾)", "category": "frequency_duration_scoped"},
  {"id": "MX152", "pointer": "/M7/overview", "text": "필러나 보톡스만으로는 한계가 있는 얼굴 하부(볼, 턱선, 팔자주름) 처짐 교정", "category": "comparison_limit_site"},
  {"id": "MX153", "pointer": "/M7/mechanism", "text": "코그실(톱니실)의 경우 직접적인 리프팅 효과", "category": "subtype_condition"},
  {"id": "MX154", "pointer": "/M7/aftercare/0", "text": "시술 후 2~4주간 입을 크게 벌리거나 과도한 표정 짓기 피하기", "category": "time_window_avoidance"},
  {"id": "MX155", "pointer": "/M7/aftercare/2", "text": "시술 후 1주일간 격렬한 운동, 사우나 피하기", "category": "time_window_avoidance"},
  {"id": "MX156", "pointer": "/M7/onset_duration/duration", "text": "코그실 6~18개월, 모노실 6~12개월 (실 소재와 종류에 따라 다름)", "category": "subtype_time"},
  {"id": "MX157", "pointer": "/M7/indications/extended/4", "text": "이마/미간 주름 개선 (모노실)", "category": "subtype_condition"},
  {"id": "MX158", "pointer": "/M7/contraindications/relative/2", "text": "이전 골 수술이나 안면 수술 이력이 있는 경우 의사와 상의", "category": "history_condition_obligation"},
  {"id": "MX159", "pointer": "/M8/safety/serious/2", "text": "눈 손상 (보호안경 미착용 시)", "category": "negated_condition"},
  {"id": "MX160", "pointer": "/M8/safety/uncommon/0", "text": "특히 아시안 피부에서 흔함", "category": "population_frequency", "note": "uncommon 칸 안의 「흔함」(I9)"},
  {"id": "MX161", "pointer": "/M8/safety/emergency/0", "text": "피부가 심하게 하얗게 변하거나 검게 탄다면 즉시 시술 중단", "category": "sign_condition_urgent_action"},
  {"id": "MX162", "pointer": "/M8/mechanism", "text": "레이저 조사 시간을 표적의 열이완시간(열이 식는 데 걸리는 시간)보다 짧게 유지하면", "category": "comparison_condition"},
  {"id": "MX163", "pointer": "/M8/mechanism", "text": "주위 정상 조직에는 열손상 없이", "category": "negated_statement"},
  {"id": "MX164", "pointer": "/M8/onset_duration/onset", "text": "색소 레이저는 1~2주 후 딱지 탈락 시, 프랙셔널은 1~3개월에 걸쳐 서서히", "category": "subtype_time"},
  {"id": "MX165", "pointer": "/M8/onset_duration/duration", "text": "(노화는 계속 진행되므로)", "category": "causal"},
  {"id": "MX166", "pointer": "/M8/contraindications/relative/0", "text": "최근 과도한 자외선 노출이나 인공 태닝을 한 경우 (색소침착 위험 증가)", "category": "time_vague_condition_risk"},
  {"id": "MX167", "pointer": "/M8/contraindications/relative/2", "text": "이소트레티노인(여드름 치료제) 복용 후 6개월 이내", "category": "medication_time_window"},
  {"id": "MX168", "pointer": "/M8/contraindications/absolute/2", "text": "켈로이드 체질 (박피형 레이저 시)", "category": "subtype_condition"},
  {"id": "MX169", "pointer": "/M8/overview", "text": "거의 모든 피부 문제에", "category": "degree_scope"},
  {"id": "MX170", "pointer": "/M9/safety/common/0", "text": "대부분 수 시간 내 사라짐", "category": "course_frequency_time"},
  {"id": "MX171", "pointer": "/M9/safety/common/1", "text": "경우에 따라 2~3일 지속", "category": "condition_time"},
  {"id": "MX172", "pointer": "/M9/safety/serious/1", "text": "(수 주~수 개월 후, 특히 단극성 장비에서 지방층 경계면의 과도한 열 작용 시)", "category": "time_subtype_condition"},
  {"id": "MX173", "pointer": "/M9/safety/serious/2", "text": "심한 함몰이나 흉터는 진피하 절제술, 지방이식, 필러 등으로 교정 필요", "category": "management_in_safety", "note": "safety 칸이 교정 방법 진술(I6)"},
  {"id": "MX174", "pointer": "/M9/safety/uncommon/0", "text": "(너무 높은 에너지 사용 시 물집)", "category": "degree_condition"},
  {"id": "MX175", "pointer": "/M9/mechanism", "text": "감각신경 및 운동신경을 자극하지 않아, 근육수축을 일으키지 않으면서", "category": "negated_statement"},
  {"id": "MX176", "pointer": "/M9/indications/primary/2", "text": "잔주름뿐만 아니라 굵은 주름도", "category": "scope_inclusion"},
  {"id": "MX177", "pointer": "/M9/onset_duration/duration", "text": "6~12개월 유지 (장비와 에너지 강도에 따라 다름)", "category": "time_with_condition"},
  {"id": "MX178", "pointer": "/M9/contraindications/relative/2", "text": "금속 물질을 몸 안에 착용한 경우 (금속 제거 후 시술)", "category": "condition_with_remedy", "note": "absolute/0 과 겹침(I5)"},
  {"id": "MX179", "pointer": "/M9/contraindications/relative/3", "text": "피부가 얇은 부위 (이마, 관자놀이 등)는 조심해서 시술", "category": "thickness_site_caution", "note": "「얇은」 = 피부 두께"},
  {"id": "MX180", "pointer": "/M14/indications/extended/3", "text": "등 지방", "category": "site_mention", "note": "부위 키워드 규칙에서 「등」(등의/등 = etc.) 오탐 때문에 제외한 부위어를 수동으로 기록"},
  {"id": "MX181", "pointer": "/M10/overview", "text": "복부, 엉덩이, 팔, 다리 등의 근육 강화와 지방 감소를 목적으로", "category": "site_list_purpose"},
  {"id": "MX182", "pointer": "/M12/overview", "text": "고대부터 내려오는 자연적 상처치유 원리를 현대 과학으로 재정립한", "category": "historical_claim"},
  {"id": "MX183", "pointer": "/M2/overview", "text": "1893년부터 시작된 오랜 역사", "category": "historical_claim"},
  {"id": "MX184", "pointer": "/M5/overview", "text": "1987년 심장수술에서 처음 사용된 후", "category": "historical_claim"},
  {"id": "MX185", "pointer": "/M8/overview", "text": "1960년대 처음 개발된 후", "category": "historical_claim"},
  {"id": "MX186", "pointer": "/M7/overview", "text": "2000년대 초반부터 인기를 얻기 시작했으며", "category": "historical_claim"},
  {"id": "MX187", "pointer": "/M1/overview", "text": "1990년대부터 미용 시술로 널리 퍼졌다", "category": "historical_claim"},
  {"id": "MX188", "pointer": "/M14/overview", "text": "지방세포만 선택적으로 파괴하는 비수술적 지방 감소 시술", "category": "selectivity_negated_prefix"},
  {"id": "MX189", "pointer": "/M9/overview", "text": "비침습적(피부를 찌르지 않는)", "category": "negated_prefix_gloss"},
  {"id": "MX190", "pointer": "/M16/overview", "text": "'백옥주사(글루타치온)', '신데렐라주사(알파리포산)', '마늘주사(비타민B1)'", "category": "named_variant_with_ingredient"}
 ]
}
