{"version":"1.1","updated":"2026-04-05","description":"시술 전 체크리스트. 카테고리별 universal + category-specific 확인 항목","universal_checks":[{"id":"allergies","label":"알레르기 병력","type":"must_check","description":"약물/식품/라텍스 알레르기"},{"id":"anticoagulants","label":"항응고제/항혈소판제","type":"must_check","description":"아스피린, 와파린, NOAC, 오메가3, 은행잎 추출물 등 — 멍/출혈 위험 안내. 중단 여부는 처방의와 상의 필수."},{"id":"autoimmune","label":"자가면역질환","type":"must_check","description":"루푸스, 류마티스, 경피증 등 — 시술 반응 예측 어려움, 이물반응/상처 회복 지연 위험 증가"},{"id":"breastfeeding","label":"수유 여부","type":"relative_contraindication","description":"수유 중인 경우 일부 시술 제한. 시술별 개별 판단 필요"},{"id":"expectations","label":"기대치 확인","type":"counseling","description":"현실적인 결과 설명"},{"id":"herpes","label":"헤르페스 병력","type":"must_check","description":"구순포진 병력 시 항바이러스 예방 투여 필요 (발라시클로비르 500mg x2 또는 아시클로비르 400mg x2, 시술 3일 전부터)"},{"id":"isotretinoin","label":"이소트레티노인 복용력","type":"inform","description":"프락셔널/얕은 필링은 중단 후 최소 6개월, 박리성(ablative) 레이저는 12개월 대기 원칙. 상처 회복 지연·비후성 반흔 위험. 2017 AAD Task Force 이후 비박리성 얕은 시술은 피부 재생 상태에 따라 의사 판단으로 조기 시행 고려 가능. 중단 후 기간 반드시 확인."},{"id":"medical_history","label":"기저질환","type":"must_check","description":"자가면역질환, 켈로이드 체질, 당뇨, 간질환"},{"id":"medications","label":"현재 복용 약물","type":"must_check","description":"항응고제, NSAIDs, 이소트레티노인 등"},{"id":"pregnancy","label":"임신 여부","type":"absolute_contraindication","description":"임신 중이거나 임신 가능성이 있는 경우 대부분의 시술 불가"},{"id":"previous_procedures","label":"최근 시술 이력","type":"must_check","description":"최근 받은 시술과 시기"},{"id":"skin_condition","label":"시술 부위 피부 상태","type":"must_check","description":"감염, 염증, 상처, 헤르페스 활성"}],"category_specific":[{"id":"M1","name":"보톡스","checks":[{"label":"신경근접합부 질환(중증근무력증 등) 확인","type":"absolute_contraindication"},{"label":"이전 보툴리눔 독소 시술 후 이상반응 여부","type":"must_check"},{"label":"항응고제 복용 여부 (멍 위험 안내)","type":"inform"},{"label":"최근 보톡스 시술 시기 확인 (항체 내성)","type":"must_check"},{"label":"아미노글리코시드 항생제 복용 여부 (보톡스 효과 증강 위험 — 겐타마이신, 토브라마이신 등)","type":"must_check"},{"label":"D-페니실라민 복용 여부 (신경근접합부 기능 감소 — 보톡스 효과 예측 불가)","type":"must_check"},{"label":"시술 부위 감염/염증 여부","type":"must_check"}]},{"id":"M2","name":"필러","checks":[{"label":"히알루로니다아제 알레르기 여부","type":"must_check"},{"label":"이전 필러 시술 부위 및 제품 확인 (잔여 필러)","type":"must_check"},{"label":"잔여 영구필러(실리콘/PMMA) 존재 여부 — 이물반응, 합병증 위험 대폭 증가","type":"must_check"},{"label":"자가면역질환 여부 (육아종 위험)","type":"must_check"},{"label":"혈관폐색 응급 프로토콜 준비 확인","type":"safety_protocol"},{"label":"히알루로니다아제 비상 비치 확인","type":"safety_protocol"},{"label":"HA vs 비HA 필러 선택 및 용해 가능 여부 설명","type":"counseling"},{"label":"최근 치과 시술 여부 확인 — 구강 내 세균이 혈행성 전파로 필러 감염 경로가 될 수 있음","type":"must_check"},{"label":"48시간 이내 비행기 탑승 예정 여부 — 기내 기압이 필러를 이동시키지는 않으나, 장시간 비행 시 붓기·멍이 더 도드라져 보일 수 있음(미용상)","type":"inform"},{"label":"피부결핵/매독 등 만성감염 여부","type":"must_check"}]},{"id":"M3","name":"바이오스티뮬레이터/콜라겐부스터","checks":[{"label":"켈로이드 체질 확인","type":"absolute_contraindication"},{"label":"자가면역질환 여부 (이물반응 위험)","type":"must_check"},{"label":"이전 바이오스티뮬레이터 시술 이력 및 제품 확인","type":"must_check"},{"label":"결절/육아종 발생 가능성 설명","type":"counseling"},{"label":"효과 발현 시기 안내 (1-3개월 점진적)","type":"counseling"},{"label":"시술 부위 감염/활동성 피부질환 여부","type":"must_check"}]},{"id":"M4","name":"스킨부스터","checks":[{"label":"HA 성분 알레르기 여부","type":"must_check"},{"label":"최근 피부 시술 이력 (레이저, 필링 등)","type":"must_check"},{"label":"항응고제/아스피린 복용 여부 (멍 위험)","type":"inform"},{"label":"시술 부위 활동성 여드름/감염 여부","type":"must_check"},{"label":"다운타임 안내 (붉어짐, 구진 1-3일)","type":"counseling"}]},{"id":"M5","name":"PRP/자가혈","checks":[{"label":"혈소판감소증/혈액질환 여부","type":"absolute_contraindication"},{"label":"항응고제/항혈소판제 복용 여부","type":"must_check"},{"label":"활동성 감염/패혈증 여부","type":"absolute_contraindication"},{"label":"자가면역질환 여부","type":"must_check"},{"label":"NSAIDs 복용 중단 여부 (시술 1주 전)","type":"must_check"},{"label":"채혈량 및 원심분리 과정 설명","type":"counseling"}]},{"id":"M6","name":"지방이식","checks":[{"label":"마취 알레르기 여부 (리도카인 등)","type":"absolute_contraindication"},{"label":"출혈 경향/응고장애 여부","type":"must_check"},{"label":"공여 부위 충분한 지방량 확인","type":"must_check"},{"label":"지방색전증 위험 설명","type":"safety_protocol"},{"label":"생착률 안내 (30-70%, 개인차)","type":"counseling"},{"label":"비대칭/과교정/흡수 가능성 설명","type":"counseling"},{"label":"감염 예방 항생제 준비 확인","type":"safety_protocol"}]},{"id":"M7","name":"실리프팅","checks":[{"label":"시술 부위 활동성 감염 여부","type":"absolute_contraindication"},{"label":"항응고제 복용 여부","type":"must_check"},{"label":"이전 실리프팅 이력 확인 (잔여 실)","type":"must_check"},{"label":"켈로이드 체질 확인","type":"must_check"},{"label":"실 종류(녹는 실 vs 비녹는 실) 및 장단점 설명","type":"counseling"},{"label":"실 돌출/감염/비대칭 가능성 설명","type":"counseling"},{"label":"시술 후 크게 입벌리기/마사지 제한 안내","type":"inform"}]},{"id":"M8","name":"레이저","checks":[{"label":"Fitzpatrick 피부타입 확인 (I-VI)","type":"must_check"},{"label":"최근 일광노출/태닝 여부 — 2-4주 이내 자외선 노출 시 에너지 감소 or 시술 연기 판단","type":"must_check"},{"label":"이소트레티노인 복용 여부/중단 시점 확인 — 프락셔널/얕은 필링 6개월, 박리성 레이저 12개월 대기 원칙. 2017 AAD Task Force 이후 비박리성 얕은 시술은 의사 판단 하에 조기 고려 가능","type":"must_check"},{"label":"광과민성 약물 복용 여부 (독시사이클린, 아미오다론 등)","type":"must_check"},{"label":"헤르페스 병력 확인 — 구순/안면 레이저 시 예방적 항바이러스제 (아시클로비르 400mg x2 또는 발라시클로비르 500mg x2, 시술 3일 전부터 시작, 7-10일 복용)","type":"must_check"},{"label":"켈로이드 체질 확인 (어블레이티브 레이저)","type":"must_check"},{"label":"PIH 위험도 평가 (고위험군 사전 미백 치료)","type":"must_check"},{"label":"중등도 이상 필링 후 최소 2주 대기 확인 — 피부 장벽 회복 전 레이저 시 합병증 위험","type":"must_check"},{"label":"금속 임플란트 확인 — RF/HIFU 병행 시 금속 발열 위험","type":"must_check"},{"label":"보호안경/눈 보호 준비 확인","type":"safety_protocol"},{"label":"레이저 종류별 다운타임 설명","type":"counseling"}]},{"id":"M9","name":"기기 리프팅","checks":[{"label":"체내 금속 임플란트/페이스메이커 여부","type":"absolute_contraindication"},{"label":"시술 부위 필러/실리콘 존재 여부","type":"must_check"},{"label":"최근 골드 실/금속 실 시술 이력","type":"absolute_contraindication"},{"label":"신경계 질환 여부 (간질 등)","type":"must_check"},{"label":"초음파/RF 에너지별 특성 및 통증 수준 설명","type":"counseling"},{"label":"지방층 두께 확인 (HIFU 시 화상 위험)","type":"must_check"}]},{"id":"M10","name":"HIFES/EMS","checks":[{"label":"체내 금속 임플란트/페이스메이커 여부","type":"absolute_contraindication"},{"label":"간질/경련성 질환 여부","type":"absolute_contraindication"},{"label":"최근 복부/시술 부위 수술 이력","type":"must_check"},{"label":"임신 여부 (복부 시술 시 특히 중요)","type":"absolute_contraindication"},{"label":"횡문근융해증 위험 설명 (과도한 세팅)","type":"inform"},{"label":"기대 효과 및 한계 설명 (지방감소가 아닌 근육강화)","type":"counseling"}]},{"id":"M11","name":"니들RF","checks":[{"label":"체내 금속 임플란트 여부 (시술 부위)","type":"absolute_contraindication"},{"label":"켈로이드 체질 확인","type":"must_check"},{"label":"이소트레티노인 복용 여부/중단 시점 확인 — 프락셔널/얕은 필링 6개월, 박리성 레이저 12개월 대기 원칙 (비박리성 얕은 시술은 의사 판단 하에 조기 고려 가능)","type":"must_check"},{"label":"항응고제 복용 여부 (출혈 위험)","type":"must_check"},{"label":"활동성 여드름/감염 부위 확인","type":"must_check"},{"label":"마취크림 도포 및 시간 안내","type":"inform"},{"label":"시술 후 붉어짐/부종 다운타임 설명","type":"counseling"}]},{"id":"M12","name":"마이크로니들링(MTS)","checks":[{"label":"활동성 여드름/감염/헤르페스 여부","type":"absolute_contraindication"},{"label":"켈로이드 체질 확인","type":"must_check"},{"label":"이소트레티노인 복용 여부/중단 시점 확인 — 프락셔널/얕은 필링 6개월, 박리성 레이저 12개월 대기 원칙 (비박리성 얕은 시술은 의사 판단 하에 조기 고려 가능)","type":"must_check"},{"label":"항응고제/항혈소판제 복용 여부","type":"must_check"},{"label":"당뇨/면역저하 상태 (감염 위험 증가)","type":"must_check"},{"label":"니들 깊이별 다운타임 설명","type":"counseling"},{"label":"시술 후 자외선 차단 필수 안내","type":"inform"}]},{"id":"M13","name":"플라즈마","checks":[{"label":"페이스메이커/전자 의료기기 여부","type":"absolute_contraindication"},{"label":"시술 부위 금속 임플란트 여부","type":"must_check"},{"label":"광과민성 질환/약물 복용 여부","type":"must_check"},{"label":"켈로이드 체질 확인","type":"must_check"},{"label":"시술 부위 활동성 감염 여부","type":"must_check"},{"label":"크러스트(딱지) 형성 및 관리 방법 설명","type":"counseling"}]},{"id":"M14","name":"크라이오리포라이시스","checks":[{"label":"한냉두드러기/한냉글로불린혈증 여부","type":"absolute_contraindication"},{"label":"발작성 한냉혈색소뇨증 여부","type":"absolute_contraindication"},{"label":"레이노 증후군 여부","type":"must_check"},{"label":"BMI/체형 적합성 평가 (피하지방 두께 측정)","type":"must_check"},{"label":"탈장 여부 (복부 시술 시)","type":"must_check"},{"label":"역설적 지방증식(PAH) 가능성 설명 (0.005-0.39%)","type":"counseling"},{"label":"시술 부위 피부 감각 이상