+def test_postgres_makes_one_task_when_the_same_creation_key_arrives_twice_at_once() -> None:
+    """같은 키의 **동시 실행**이 중복 업무도 중복 활성 담당도 만들지 않는다 (SPEC-001 §6 W1).
