###############################################################################
# kknaks_profile — 환경변수 템플릿
#
# 사용법: 이 파일을 `.env` 로 복사한 뒤 실제 값을 박는다.
#   cp .env.example .env
#
# `.env` 는 .gitignore 처리됨 (절대 commit 금지).
# 모든 env 는 back/config.py 의 함수형 entry point 통해 접근.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# open-kknaks (LLM 호출 — ADR-04)
# ─────────────────────────────────────────────────────────────────────────────

# claude CLI OAuth 토큰. 호스트에서 `claude setup-token` 1회 실행 → 출력값 박기.
# worker 컨테이너가 .claude-tools/ 마운트 + 이 토큰으로 claude CLI 호출.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Events API (잔디 잡 입력 — spec-03 §2.4)
# ─────────────────────────────────────────────────────────────────────────────

# 개인 GitHub 계정 — 잔디 잡 입력 + 서버가 git push 시 commit author/credential.
# 셋 다 필수 (운영 시 — 빈 값이면 bot_identity 미설정 → push skip):
#   - GH_USER_PERSONAL : GitHub username
#   - GH_TOKEN_PERSONAL: PAT (scope: repo)
#   - GH_EMAIL_PERSONAL: git commit author email — Settings → Emails 의 primary.
#                        private 박혀있으면 `<id>+<user>@users.noreply.github.com`
GH_USER_PERSONAL=kknaks
GH_TOKEN_PERSONAL=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GH_EMAIL_PERSONAL=your-git-email@example.com

# 회사 GitHub 계정 (선택) — 빈 값이면 skip.
# 각 계정의 private repo 는 그 계정 PAT 으로만 보임. 한 PAT 으로 두 계정 못 봄.
GH_USER_COMPANY=
GH_TOKEN_COMPANY=
GH_EMAIL_COMPANY=

# ─────────────────────────────────────────────────────────────────────────────
# Webhook + Reload (admin/reload — spec-06 §1)
# ─────────────────────────────────────────────────────────────────────────────

# GitHub webhook HMAC secret — repo Settings → Webhooks 에서 박는 값과 동일.
# 32+ chars 권장. `openssl rand -hex 32` 로 생성.
GITHUB_WEBHOOK_SECRET=

# cron `git pull` + curl 또는 수동 reload 호출용 토큰. 임의 random.
RELOAD_TOKEN=changeme

# Slack incoming webhook — 잔디 잡 결과 알림 (성공/실패). 미박음 시 notify no-op.
# 발급: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Slack knowledge capture — Socket Mode (WORK-006).
# KDEV-WORK-012 부터 별도 slack-bridge 컨테이너가 아니라 **back 프로세스 안**에서 돈다.
# 기본 비활성 — 0 이거나 토큰이 없으면 캡처만 skip 하고 back 은 정상 부팅한다.
SLACK_CAPTURE_ENABLED=0
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ALLOWED_SLACK_USERS=
ALLOWED_SLACK_CHANNELS=
CAPTURE_PROVIDER=claude
CAPTURE_MODEL=
CAPTURE_WORK_DIR=/repo
CAPTURE_TIMEOUT_SECONDS=600

# ─────────────────────────────────────────────────────────────────────────────
# 인프라 (docker-compose 와 동일)
# ─────────────────────────────────────────────────────────────────────────────

# Redis broker (open-kknaks). docker-compose 안에선 redis://redis:6379, 호스트는 localhost:46379.
# REDIS_URL=redis://localhost:46379

# 페르소나 디렉토리 (docker 안 /persona, 호스트 default ../persona).
# PERSONA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# 애플리케이션 DB + 관리자 인증 (KDEV-SPEC-006 / WORK-011)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL DSN (SQLAlchemy 2.0 동기, psycopg3).
#   docker 안: postgresql+psycopg://kknaks:kknaks@postgres:5432/kknaks
#   호스트에서 alembic/로컬 실행: localhost:45433 (compose 가 4-prefix 로 노출)
DATABASE_URL=postgresql+psycopg://kknaks:kknaks@localhost:45433/kknaks

# postgres 컨테이너 초기화 값 (docker-compose 의 POSTGRES_* 와 DATABASE_URL 을 일치시킬 것).
POSTGRES_USER=kknaks
POSTGRES_PASSWORD=kknaks
POSTGRES_DB=kknaks

# 관리자 시드 — 부팅 시 이 값으로 users 를 멱등 upsert (비번은 bcrypt 해시로 저장).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 세션 JWT — 운영은 반드시 강한 값으로. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_EXPIRE_MINUTES=720

# 세션 쿠키 — 운영은 서브도메인 공유(.kknaks.cloud) + HTTPS 전용. 로컬은 비움 + 0.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=0

# ─────────────────────────────────────────────────────────────────────────────
# 잡 동작 모드
# ─────────────────────────────────────────────────────────────────────────────

# 운영 = "1" (cron 활성). 테스트 = "0".
RUN_SCHEDULER=1

# 잡이 실 git push 할지 — 운영 = "0", dev/staging = "1".
# ⚠ 운영 시 반드시 0 으로 박을 것. 1 이면 enrich/잔디 잡이 dry_run 모드라 GitHub 에 commit 안 박힘.
JOB_GIT_PUSH_DRY_RUN=0

# 승인 발행(Apply Executor)만 끄는 플래그 — 위 플래그와 별개다 (KDEV-WORK-015).
# 위를 1 로 올리면 잔디·알고리즘·교안 push 가 전부 멈춘다. 발행만 시험할 때 이걸 쓴다.
# 1 = 파일은 작업트리에 쓰되 커밋·push 안 함. 검증 끝나면 0.
PUBLISH_DRY_RUN=1
