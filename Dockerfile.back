FROM python:3.13-slim

# git — jobs/inputs.py의 git_log_today 호출에 필요 (spec-03 §2.2)
# build deps — pydantic-core 등 일부 패키지가 컴파일 필요할 수 있음
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# uv — 의존성 매니저 (app/back/pyproject.toml과 일관)
RUN pip install --no-cache-dir uv

WORKDIR /repo/app/back

# venv 를 mount 영역 (/repo) 밖에 박음 — compose `.:/repo` 가 .venv 를 host 로 덮어쓰는 충돌 회피
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# 의존성 먼저 (Docker layer caching — pyproject 안 바뀌면 재install 안 함)
# build context = repo root → app/back/ prefix 명시
COPY app/back/pyproject.toml app/back/uv.lock ./
RUN uv sync --frozen --no-install-project \
    && chmod -R a+rX /opt/venv

# playwright chromium + system deps (planning-02 — PDF 생성 잡 · KDEV-SPEC-016 동적 수집)
# --with-deps 가 chromium 실행에 필요한 OS 라이브러리 (libnss, libatk 등) 자동 설치.
#
# **설치 위치를 명시한다.** 기본값은 `$HOME/.cache/ms-playwright` 인데 빌드는 root,
# 런타임은 `user: "1000:1000"` + `HOME=/tmp` 라 서로 다른 곳을 본다 — 브라우저가
# 이미지 안에 있는데도 `Executable doesn't exist at /tmp/.cache/...` 로 죽었다.
# HOME 에 안 묶인 고정 경로에 두고 모두가 읽게 한다.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv run playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

# compose 의 `user: "1000:1000"` 가 venv 갱신 시 root 소유 파일을 못 지워서 부팅 실패하던 이슈 영구 차단.
RUN chown -R 1000:1000 /opt/venv /tmp 2>/dev/null || true

# 잔디 bare 클론 캐시 (KDEV-WORK-017 P5 / KDEV-SPEC-011). compose 의 named volume 이
# 여기 붙는다 — **이미지에 디렉터리가 없으면 볼륨이 root:root 로 생겨** 비루트 유저가
# 못 쓴다. 미리 만들어 두면 fresh volume 이 이 소유·모드를 물려받는다.
# 1777 인 이유는 로컬 compose 가 다른 uid(501:20)로 도는데 볼륨 소유는 하나뿐이기 때문이다.
RUN mkdir -p /var/cache/repos \
    && chown 1000:1000 /var/cache/repos \
    && chmod 1777 /var/cache/repos

# 코드 복사 — compose 의 mount (.:/repo) 가 런타임에 덮어쓰지만 fallback 으로 박아둠
COPY app/back/ .

# 엔트리포인트는 **마운트 영역 밖**에 둔다. `/repo` 는 런타임에 호스트 레포로
# 덮이므로, 거기에 두면 실행 권한·존재 여부가 호스트 상태에 좌우된다.
COPY app/back/entrypoint.sh /usr/local/bin/back-entrypoint.sh
RUN chmod 755 /usr/local/bin/back-entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PERSONA_DIR=/repo/persona \
    PYTHONPATH=/repo/app/back \
    UV_CACHE_DIR=/tmp/uv-cache \
    HOME=/tmp

EXPOSE 48000

# 기동 = 마이그레이션 + 서버. 스키마 없이 뜨면 관리자·큐가 조용히 죽는다.
# (single-worker 강제는 entrypoint 안 — spec-03 §1.2)
ENTRYPOINT ["/usr/local/bin/back-entrypoint.sh"]
