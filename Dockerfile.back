FROM python:3.13-slim

# git — jobs/inputs.py의 git_log_today 호출에 필요 (spec-03 §2.2)
# build deps — pydantic-core 등 일부 패키지가 컴파일 필요할 수 있음
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# uv — 의존성 매니저 (back/pyproject.toml과 일관)
RUN pip install --no-cache-dir uv

WORKDIR /repo/back

# venv 를 mount 영역 (/repo) 밖에 박음 — compose `.:/repo` 가 .venv 를 host 로 덮어쓰는 충돌 회피
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# 의존성 먼저 (Docker layer caching — pyproject 안 바뀌면 재install 안 함)
# build context = repo root → back/ prefix 명시
COPY back/pyproject.toml back/uv.lock ./
RUN uv sync --frozen --no-install-project \
    && chmod -R a+rX /opt/venv

# playwright chromium + system deps (planning-02 — PDF 생성 잡)
# --with-deps 가 chromium 실행에 필요한 OS 라이브러리 (libnss, libatk 등) 자동 설치.
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv run playwright install --with-deps chromium

# compose 의 `user: "1000:1000"` 가 venv 갱신 시 root 소유 파일을 못 지워서 부팅 실패하던 이슈 영구 차단.
RUN chown -R 1000:1000 /opt/venv /tmp 2>/dev/null || true

# 코드 복사 — compose 의 mount (.:/repo) 가 런타임에 덮어쓰지만 fallback 으로 박아둠
COPY back/ .

ENV PYTHONUNBUFFERED=1 \
    PERSONA_DIR=/repo/persona \
    PYTHONPATH=/repo/back \
    UV_CACHE_DIR=/tmp/uv-cache \
    HOME=/tmp

EXPOSE 48000

# single-worker 강제 (spec-03 §1.2 — APScheduler 다중 발동 차단)
CMD ["uv", "run", "--no-sync", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "48000", "--workers", "1"]
