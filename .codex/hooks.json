{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start_git_pull.sh\"",
            "timeout": 30,
            "statusMessage": "Pulling latest git changes"
          }
        ]
      }
    ]
  }
}
